{% extends 'base.html.twig' %}
{% block title %}Liste des Categories{% endblock %}
{% block body %}
<h4>Gestion des Catégories</h4>
<div class="content">
    <div class="list">
        {% for categorie in categories %}
            <div class="card">
                <p><strong>Libellé :</strong> {{ categorie.libelle }}</p>
                {% if is_granted('ROLE_ADMIN') %}
                <div class="actions">
                    <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">
                        <button class="warning">MODIFIER</button>
                    </a>
                    {{ include('categorie/_delete_form.html.twig') }}
                </div>
                {% endif %}
            </div>
        {% else %}
            <p>No records found.</p>
        {% endfor %}
    </div>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_categorie_new') }}">
        <button>Créer une catégorie</button>
    </a>
    {% endif %}
</div>
{% endblock %}