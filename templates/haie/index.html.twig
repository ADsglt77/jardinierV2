{% extends 'base.html.twig' %}
{% block title %}Liste des Haies{% endblock %}
{% block body %}
<h4>Gestion des Haie</h4>
<div class="content">
    <div class="list">
        {% for haie in haies %}
            <div class="card">
                <p><strong>Nom :</strong> {{ haie.nom }}</p>
                <p><strong>Prix :</strong> {{ haie.prix }}€</p>
                <p><strong>Type :</strong> {{ haie.categorie.libelle }}</p>
                <div class="actions">
                    <a href="{{ path('app_haie_show', {'id': haie.id}) }}">
                        <button class="info">VOIR</button>
                    </a>
                    <a href="{{ path('app_haie_edit', {'id': haie.id}) }}">
                        <button class="warning">MODIFIER</button>
                    </a>
                    {{ include('haie/_delete_form.html.twig') }}
                </div>
            </div>
        {% else %}
            <p>No records found.</p>
        {% endfor %}
    </div>
    <a href="{{ path('app_haie_new') }}" class="create">
        <button>Ajouter une Haie</button>
    </a>
</div>
{% endblock %}